# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

ARG NODE_IMAGE="docker.io/library/node:24.17.0-trixie-slim@sha256:9022946fb57e6fb6a2503931470deba4b49db02bfc8f587f93007fd33ef54415"

FROM ${NODE_IMAGE} AS dependencies

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY npm ./npm
COPY internal-ui ./internal-ui

RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --legacy-peer-deps --ignore-scripts=false

FROM dependencies AS builder

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM ${NODE_IMAGE} AS runtime

ARG VERSION
ARG COMMIT
ARG BUILD_DATE

LABEL org.opencontainers.image.title="Stigen-maintained Ory Polis" \
      org.opencontainers.image.description="Pinned, tested, signed build of Ory Polis" \
      org.opencontainers.image.source="https://github.com/stigenai/polis" \
      org.opencontainers.image.url="https://github.com/stigenai/polis" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

RUN apt-get update \
    && apt-get upgrade -y \
    && npm install --global --omit=dev \
    ts-node@10.9.2 \
    typescript@5.9.3 \
      migrate-mongo@14.0.7 \
    typeorm@0.3.31 \
      reflect-metadata@0.2.2 \
      mssql@12.2.1 \
    mysql2@3.24.3 \
      pg@8.20.0 \
  && npm cache clean --force \
  && rm -rf /usr/local/lib/node_modules/npm \
     /usr/local/bin/npm \
     /usr/local/bin/npx \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_OPTIONS="--max-http-header-size=81920 --dns-result-order=ipv4first" \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=5225

RUN groupadd --system --gid 10000 polis \
    && useradd --system --uid 10000 --gid polis --home-dir /app --shell /usr/sbin/nologin polis

COPY --from=builder --chown=10000:10000 /app/public ./public
COPY --from=builder --chown=10000:10000 /app/.next/standalone ./
COPY --from=builder --chown=10000:10000 /app/.next/static ./.next/static
COPY --from=builder --chown=10000:10000 /app/migrate.sh ./migrate.sh
COPY --from=builder --chown=10000:10000 /app/npm ./npm

RUN chmod 0555 /app/migrate.sh

USER 10000:10000

EXPOSE 5225

CMD ["node", "server.js"]
